{
  "name": "@amirjalili1374/ui-kit",
  "version": "1.10.1",
  "description": "A reusable UI component library built with Vue 3, Vuetify, and TypeScript",
  "type": "module",
  "sideEffects": [
    "./dist/style.css"
  ],
  "main": "./dist/ui-kit.cjs",
  "module": "./dist/ui-kit.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ui-kit.es.js",
      "require": "./dist/ui-kit.cjs"
    },
    "./dist/style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "keywords": [
    "vue3",
    "vue",
    "vuetify",
    "ui-components",
    "component-library",
    "typescript",
    "ui-kit"
  ],
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prelive": "vite --mode prelive",
    "dev:live": "vite --mode live",
    "dev:demo": "vite --mode demo",
    "build": "npm run typecheck && vite build --mode dev",
    "build:dev": "npm run typecheck && vite build --mode dev",
    "build:prelive": "npm run typecheck && vite build --mode prelive",
    "build:live": "npm run typecheck && vite build --mode live",
    "build:demo": "npm run typecheck && vite build --mode demo",
    "build:lib": "npm run typecheck && cross-env BUILD_LIB=true vite build && npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --project tsconfig.lib.json --skipLibCheck",
    "preview": "vite preview --port 5050 --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:watch": "vue-tsc --noEmit --watch",
    "lint": "npm run lint:check",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,scss,css,json}\"",
    "clean": "rimraf dist node_modules/.vite",
    "analyze": "vite build && npx vite-bundle-analyzer dist/stats.html",
    "test:consumer": "node scripts/verify-packed-package.mjs",
    "validate": "npm run lint:check && npm run typecheck && npm run test:coverage && npm run build:lib && npm run test:consumer",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@dsb-norge/vue-keycloak-js": "^3.0.8",
    "@mdi/js": "^7.4.47",
    "@tabler/icons-vue": "^3.44.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.6.8",
    "jalaali-js": "^1.2.8",
    "pinia": "^2.1.7",
    "vue3-lottie": "^3.3.1",
    "vue3-perfect-scrollbar": "^2.0.0",
    "vue3-persian-datetime-picker": "^1.2.2"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuetify": "^3.10.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.4.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.9.1",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.9",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.5"
  }
}
